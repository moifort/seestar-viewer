<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le même fichier sert aux deux plateformes : seul l'archivage diffère. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>46C337T7YN</string>
	<!-- La signature reste automatique. Xcode obtient certificat et profil via
	     la clé App Store Connect, ce qui évite de stocker un .p12 en secret. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Le numéro de build est fixé par le workflow, pas par Xcode. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
